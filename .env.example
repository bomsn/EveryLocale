EVERYLOCALE_HOST=127.0.0.1
EVERYLOCALE_PORT=4310
# Relative to packages/server when using pnpm start. Docker overrides this path.
EVERYLOCALE_DATABASE=../../data/everylocale.sqlite
# Generate independent random values of at least 32 characters.
EVERYLOCALE_ADMIN_TOKEN=
EVERYLOCALE_SESSION_SECRET=
EVERYLOCALE_PUBLIC_ORIGIN=http://localhost:4310
# OpenAI-compatible chat-completions base URL. Local endpoints are supported.
EVERYLOCALE_GENERATOR_URL=
EVERYLOCALE_GENERATOR_KEY=
EVERYLOCALE_GENERATOR_MODEL=
EVERYLOCALE_REVIEWER_URL=
EVERYLOCALE_REVIEWER_KEY=
EVERYLOCALE_REVIEWER_MODEL=
# Required USD per million tokens. Zero is explicit for unmetered local models.
EVERYLOCALE_GENERATOR_INPUT_PRICE=
EVERYLOCALE_GENERATOR_OUTPUT_PRICE=
EVERYLOCALE_REVIEWER_INPUT_PRICE=
EVERYLOCALE_REVIEWER_OUTPUT_PRICE=
EVERYLOCALE_CONCURRENCY=2
EVERYLOCALE_PROVIDER_INTERVAL_MS=500
