{
  "name": "@everylocale/react-router",
  "version": "0.3.0",
  "description": "React Router framework-mode integration: server-resolved locales and per-route precompiled messages.",
  "keywords": [
    "localization",
    "i18n",
    "translation",
    "icu",
    "everylocale"
  ],
  "homepage": "https://github.com/bomsn/EveryLocale#readme",
  "bugs": "https://github.com/bomsn/EveryLocale/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bomsn/EveryLocale.git",
    "directory": "packages/react-router"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@everylocale/adapters": "workspace:*",
    "@everylocale/core": "workspace:*",
    "@everylocale/react": "workspace:*",
    "@everylocale/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-router": ">=7.18 <9",
    "vite": ">=6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-router": "8.5.1",
    "vite": "8.3.7",
    "react-dom": "19.3.1",
    "@types/react-dom": "19.3.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
