{
  "name": "@everylocale/runtime",
  "version": "0.3.0",
  "description": "Framework-free formatting of approved, precompiled EveryLocale messages, and verified release loading on the server.",
  "keywords": [
    "localization",
    "i18n",
    "translation",
    "icu",
    "everylocale"
  ],
  "homepage": "https://github.com/bomsn/EveryLocale#readme",
  "bugs": "https://github.com/bomsn/EveryLocale/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bomsn/EveryLocale.git",
    "directory": "packages/runtime"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./bundler": {
      "types": "./dist/bundler.d.ts",
      "import": "./dist/bundler.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@everylocale/core": "workspace:*",
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "intl-messageformat": "12.1.5",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
