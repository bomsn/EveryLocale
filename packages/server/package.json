  "dependencies": {
    "@everylocale/core": "workspace:*",
    "@everylocale/store": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  }
}
