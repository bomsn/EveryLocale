{
  "name": "@everylocale/react",
  "version": "0.3.0",
  "description": "React bindings for EveryLocale: a provider, typed messages, and accessible language links, select and suggestion.",
  "keywords": [
    "localization",
    "i18n",
    "translation",
    "icu",
    "everylocale"
  ],
  "homepage": "https://github.com/bomsn/EveryLocale#readme",
  "bugs": "https://github.com/bomsn/EveryLocale/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bomsn/EveryLocale.git",
    "directory": "packages/react"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "assets",
    "flags",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flags/*": {
      "types": "./flags/*.d.ts",
      "import": "./flags/*.js"
    },
    "./fonts.css": "./assets/fonts.css",
    "./fonts/*": "./assets/fonts/*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@everylocale/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "@types/react": ">=18.3 <20"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1"
  },
  "sideEffects": [
    "./assets/*.css"
  ],
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
