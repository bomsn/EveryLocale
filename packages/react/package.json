{
  "name": "@everylocale/react",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "assets"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
