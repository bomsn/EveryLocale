{
  "name": "@everylocale/react",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "assets",
    "flags"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./flags/*": {
      "types": "./flags/*.d.ts",
      "import": "./flags/*.js"
    },
    "./fonts.css": "./assets/fonts.css",
    "./fonts/*": "./assets/fonts/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@everylocale/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "@types/react": ">=18.3 <20"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "react": "18.3.1"
  },
  "sideEffects": [
    "./assets/*.css"
  ],
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
